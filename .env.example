# Copy to .env and fill in. .env is git-ignored. Never paste keys into chat or commit them.

# LLM: "<provider>:<model>". Groq's free tier needs no card; when a limit is hit it returns an
# error (HTTP 429) instead of charging.
LLM_MODEL=groq:openai/gpt-oss-120b
GROQ_API_KEY=

# Read-only Sepolia RPC (public endpoint, no key needed)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Current deployment from defi-portfolio-tracker's README
STAKING_ADDRESS=0xd6AE22a0adE46C7eDbB92db28F6360089B94f513

# PUBLIC address used in the eval's staking questions (python -m eval.find_stakers lists them).
# An address only, never a private key.
EVAL_WALLET=

# Hard limits per question
MAX_TOOL_CALLS=6
MAX_MODEL_CALLS=8
# Retries after HTTP 429 (the SDK waits for the Retry-After header)
MAX_RETRIES=4
